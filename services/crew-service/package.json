{
  "name": "crew-service",
  "version": "0.1.0",
  "private": true,
  "description": "CallSheet crew service: crew profiles, departments and availability (Node.js + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test"
  },
  "dependencies": {
    "express": "^4.22.3",
